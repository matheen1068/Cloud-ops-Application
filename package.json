{
  "name": "cloud-ops",
  "private": true,
  "description": "Cloud-Ops: manage and scale Auto Scaling groups across many AWS accounts from one place.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cloud-ops/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
